  (text "MEMORY MAP (U6 74HCT151, S2:S0 = A19:A17, E# = IO/M)"
    (at 20 205.0 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 552c85c1-ebeb-186d-0205-44519d6c05cc)
  )
  (text "  00000h-1FFFFh  I0 = GND: off (motherboard RAM)" (at 20 208.3 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 7285d696-0514-1e4d-9e84-d846a1473c39)
  )
  (text "  20000h-3FFFFh  I1 = SEL128: JP1 fitted = on (128K motherboard),"
    (at 20 211.6 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid bb8e506b-026d-3a1d-31ca-af91c289073b)
  )
  (text "                 JP1 open = off (256K motherboard)"
    (at 20 214.9 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 60719ced-52c1-3c24-50f6-fce6e65ca3f7)
  )
  (text "  40000h-DFFFFh  I2-I6 = +5V: on" (at 20 218.2 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 12078224-e2ab-eaf8-7163-690f1baf769d)
  )
  (text "  E0000h-FFFFFh  I7 = GND: off" (at 20 221.5 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid d799c803-2eaa-b54b-bee1-d1f3171dcafb)
  )
  (text "U1 used as 1Mx8: LB#/UB# select the byte lane from A19"
    (at 20 224.8 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 51a61105-391f-266f-7968-06411bc34440)
  )
  (text "  (LB# = A19, UB# = A19_N; I/O8-15 = D0..D7, I/O0-7 = D7..D0)"
    (at 20 228.1 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 556c8c39-c92f-5905-c600-a20bbef03644)
  )
  (text "U5 data transceiver: DIR = /RD (H = A->B write, L = B->A read),"
    (at 20 231.4 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 36683e77-9a76-e2c6-c2ae-2ff0918b0746)
  )
  (text "  OE# = DOE_N = (/RD AND /WR) OR CE5_N" (at 20 234.7 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid c819ad98-4bc3-da33-fb59-33881e940824)
  )
  (text "Bus side (BA*, BD*, ALE, BRD_N, BWR_N, IOM) is 5 V; SRAM side is 3.3 V"
    (at 20 238.0 0)
    (effects (font (size 1.8 1.8)) (justify left))
    (uuid 6a3d16ed-adab-b017-5fce-4ad903f78cda)
  )

